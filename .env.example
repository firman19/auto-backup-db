# Copy to .env, fill in, then: chmod 600 .env
# This file is sourced by bash: keep every value in double quotes.
#
# rclone reads the "r2" remote entirely from these RCLONE_CONFIG_R2_* variables,
# so no /root/.config/rclone/rclone.conf is required.
# (To use an rclone.conf instead, delete the RCLONE_CONFIG_R2_* lines and see README.)

# --- Cloudflare R2 (S3 API credentials) -------------------------------------
RCLONE_CONFIG_R2_TYPE="s3"
RCLONE_CONFIG_R2_PROVIDER="Cloudflare"
RCLONE_CONFIG_R2_ACCESS_KEY_ID="[Insert Access Key ID]"
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="[Insert Secret Access Key]"
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT="[Insert Endpoint]"
RCLONE_CONFIG_R2_ACL="private"
# Required when the API token is scoped to a single bucket
RCLONE_CONFIG_R2_NO_CHECK_BUCKET="true"

R2_BUCKET="[Insert Bucket Name]"

# --- Reference only (rclone's S3 backend does not use these) ----------------
# R2_ACCOUNT_ID="[Insert Account ID]"
# R2_TOKEN_VALUE="[Insert Token Value]"   # Cloudflare API bearer token

# --- Optional: failure notification -----------------------------------------
# Receives a POST with JSON {"text": "...", "content": "..."} when a run fails.
# Works with Slack / Discord incoming webhooks; healthchecks.io accepts it too.
NOTIFY_WEBHOOK_URL=""
